{
  "name": "python-autograder-web-app",
  "version": "1.0.0",
  "description": "A fully client-side static web application for Python code autograding",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "preview:https": "vite preview --https",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "fast-check": "^3.15.0",
    "jsdom": "^28.1.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "monaco-editor": "^0.45.0",
    "pyodide": "^0.25.0"
  }
}
